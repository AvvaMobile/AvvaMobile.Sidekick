{
  "name": "avvamobile.sidekick",
  "productName": "Avva Mobile Sidekick",
  "version": "0.1.2",
  "private": true,
  "description": "Desktop app that pairs a ChatGPT conversation with Claude Code: plan with ChatGPT, hand prompts to Claude in one click, send results back for review.",
  "main": "out/main/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "app": "electron-vite build && node scripts/dev-bundle.cjs && \"./.dev/Avva Mobile Sidekick.app/Contents/MacOS/Electron\" .",
    "postinstall": "node scripts/fix-node-pty.cjs",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "release": "electron-vite build && electron-builder --publish always",
    "release:mac": "bash scripts/release-mac.sh"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "happy-dom": "^20.14.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "6.8.9",
    "node-pty": "^1.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "author": "Avva Mobile",
  "homepage": "https://github.com/AvvaMobile/AvvaMobile.Sidekick",
  "repository": {
    "type": "git",
    "url": "https://github.com/AvvaMobile/AvvaMobile.Sidekick.git"
  },
  "bugs": {
    "url": "https://github.com/AvvaMobile/AvvaMobile.Sidekick/issues"
  },
  "license": "MIT"
}
